# ==============================================================================
# iMovies India - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to '.env' on your local system or production server:
# cp .env.example .env

# 1. SERVER CONFIGURATION
PORT=3000
NODE_ENV=development

# 2. MONGODB ATLAS / LOCAL DATABASE CONNECTION
# Get free MongoDB Atlas connection string from https://cloud.mongodb.com
# Example format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/imovies?retryWrites=true&w=majority
# Or for local MongoDB: mongodb://127.0.0.1:27017/imovies
MONGODB_URI=mongodb+srv://krish:yourPassword123@cluster0.mongodb.net/imovies?retryWrites=true&w=majority

# 3. SECURITY & JWT BEARER TOKEN
JWT_SECRET=super_secret_jwt_key_2026_krish_imovies_india

# 4. DEVELOPER & OPERATIONS HEAD EMAIL
ADMIN_EMAIL=krisharjariya861@gmail.com

# 5. GOOGLE GEMINI AI KEY (For Real-Time Cinema Analyst & Insights)
# Automatically injected in AI Studio. For local use, get free key from: https://aistudio.google.com
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 6. APPLICATION HOST URL
APP_URL=http://localhost:3000
